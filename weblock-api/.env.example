# ============================
# WEBLOCK - ENVIRONMENT TEMPLATE
# Copy to weblock-api/.env and fill in. NEVER commit .env
# ============================

# PostgreSQL (SQLAlchemy + psycopg v3)
# Example: postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/weblock
DATABASE_URL=

# JWT
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0-phase0

# Login rate limiting (per IP+email window)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Correlation window (seconds, Phase 4)
CORRELATION_WINDOW_SECONDS=1800

# Contextual risk lookback (hours, Phase 5)
RISK_LOOKBACK_HOURS=24

# Auto-incident gate: open HIGH+ cluster needs endpoint risk >= this (Phase 6)
INCIDENT_MIN_RISK=60

# AI Security Analyst (Phase 9): disabled unless AI_ENABLED=true AND key set.
# Never commit real keys. No AI feature affects detection without a provider.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_BYTES=12000
AI_MAX_OUTPUT_BYTES=8000
AI_MAX_ANALYSES_PER_INCIDENT=20
AI_MIN_REFRESH_SECONDS=60

# Notifications (Phase 0: stubbed, no delivery)
NOTIFICATIONS_ENABLED=false
WEBLOCK_EMAIL=
WEBLOCK_EMAIL_PASSWORD=
