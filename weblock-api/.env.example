# ============================
# WEBLOCK - ENVIRONMENT TEMPLATE
# Copy to weblock-api/.env and fill in. NEVER commit .env
# ============================

# PostgreSQL (SQLAlchemy + psycopg v3)
# Example: postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/weblock
DATABASE_URL=

# JWT
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0-phase0

# Login rate limiting (per IP+email window)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Correlation window (seconds, Phase 4)
CORRELATION_WINDOW_SECONDS=1800

# Contextual risk lookback (hours, Phase 5)
RISK_LOOKBACK_HOURS=24

# Notifications (Phase 0: stubbed, no delivery)
NOTIFICATIONS_ENABLED=false
WEBLOCK_EMAIL=
WEBLOCK_EMAIL_PASSWORD=
